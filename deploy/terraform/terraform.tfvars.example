# Copy to terraform.tfvars and fill in. Identifiers below are AWS documentation examples.
name                               = "afs-dev"
region                             = "us-east-1"
dr_region                          = "us-west-2"
cluster_name                       = "afs-dev"
vpc_id                             = "vpc-0123456789abcdef0"
database_subnet_ids                = ["subnet-0123456789abcdef0", "subnet-0fedcba9876543210"]
database_client_security_group_ids = ["sg-0123456789abcdef0"]
cross_account_backup_vault_arn     = "arn:aws:backup:us-east-1:444455556666:backup-vault:afs-central"
cur_bucket_arn                     = "arn:aws:s3:::example-cur-bucket"
cur_glue_database                  = "cur"
athena_workgroup                   = "afs"
athena_results_bucket_arn          = "arn:aws:s3:::example-athena-results"

# Paperclip collaboration (optional): leave collab_base_domain out to deploy no public entry.
# collab_base_domain             = "collab.example.com"
# collab_route53_zone_id         = "Z0123456789ABCDEFGHIJ"
# collab_public_subnet_ids       = ["subnet-0aaaaaaaaaaaaaaaa", "subnet-0bbbbbbbbbbbbbbbb"]
# collab_edge_security_group_ids = ["sg-0123456789abcdef0"]

# Private orchestration entry (optional): leave the base domain out to serve public hostnames only.
# orchestration_private_base_domain     = "orch.corp.example.com"
# orchestration_private_subnet_ids      = ["subnet-0cccccccccccccccc", "subnet-0dddddddddddddddd"]
# orchestration_private_certificate_arn = "<certificate ARN for the private base domain and its wildcards>"
# orchestration_private_ingress_cidrs   = ["10.0.0.0/8"]
